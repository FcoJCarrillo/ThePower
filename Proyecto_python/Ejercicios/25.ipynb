        "\"\"\"\n",
        "Crea una función que cuente el número de caracteres en una cadena de texto dada.\n",
        "\"\"\"\n",
        "texto = \"Prueba para el ejecicio número 25\"\n",
        "\n",
        "def contar_caracteres(cadena):\n",
        "    return len(cadena)\n",
        "\n",
        "print(f\"La longitud de la lista es {contar_caracteres(texto)}\")\n"
