      "source": [
        "\"\"\"\n",
        "Crea una función lambda que sume elementos correspondientes de dos listas dadas.\n",
        "\"\"\"\n",
        "lista_1 = [1,2,3,4,5]\n",
        "lista_2 = [6,7,8,9,10]\n",
        "sumar_listas = lambda l1, l2: list(map(lambda x, y: x+y, l1, l2))\n",
        "\n",
        "sumar_listas(lista_1, lista_2)"
      ]
    }
