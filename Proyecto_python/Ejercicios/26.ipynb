        "\"\"\"\n",
        "Crea una función lambda que calcule el resto de la división entre dos números dados.\n",
        "\"\"\"\n",
        "num_1 = 20\n",
        "num_2 = 2\n",
        "resto = lambda a, b: a % b\n",
        "print(f\"El resto de la división entre {num_1} y {num_2} es {resto(num_1,num_2)}\")"
      ]
    }
