      "source": [
        "\"\"\"\n",
        "Crea una función que calcule el promedio de una lista de números.\n",
        "\"\"\"\n",
        "lista = [3,2,6,7,10,49]\n",
        "def promedio(lista):\n",
        "    return sum(lista) / len(lista)\n",
        "\n",
        "print(f\"El resultado del promedio de la lista {lista} es {promedio(lista)}\")"
      ]
    }
