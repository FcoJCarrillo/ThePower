      "source": [
        "\"\"\"\n",
        "Crea una función lambda que filtre los números impares de una lista dada.\n",
        "\"\"\"\n",
        "lista = [3,2,6,7,10,49,395,623]\n",
        "impares = lambda lista: list(filter(lambda x: x % 2 != 0, lista))\n",
        "print(impares(lista))"
      ]
    }
