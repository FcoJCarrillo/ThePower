        "\"\"\"\n",
        "Crea una función lambda que sume 3 a cada número de una lista dada.\n",
        "\"\"\"\n",
        "sumar_lista = lambda lista: list(map(lambda x:x + 3, lista))\n",
        "\n",
        "numeros = [3,5,7]\n",
        "sumar_lista(numeros)"
      ]
