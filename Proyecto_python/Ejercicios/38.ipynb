      "source": [
        "\"\"\"\n",
        "Genera un programa que nos diga si es de noche, de día o tarde según la hora proporcionada por el usuario.\n",
        "\"\"\"\n",
        "hora = int(input(\"Introduce la hora (0-23): \"))\n",
        "\n",
        "if 6 <= hora < 12:\n",
        "    print(\"Es de día\")\n",
        "\n",
        "elif 12 <= hora < 20:\n",
        "    print(\"Es tarde\")\n",
        "\n",
        "else:\n",
        "    print(\"Es de noche\")"
      ]
    }
  ],
